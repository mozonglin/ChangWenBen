    {
      "chart_uid": "051c4f28-0bf1-11f0-b328-bc2411cbc733",
      "chart_name": "菜品销售量与平均单价分析",
      "chart_type": "BarChart",
      "chart_desc": "通过分析菜品的销售份数与销售额的关系，可以了解哪些菜品的销售量较高但销售额较低，反之亦然。这有助于发现销售量大但单价低的菜品，以及销售量低但单价高的菜品，为调整菜品价格或促销策略提供参考。",
      "chart_sql": "SELECT 菜品名称 AS dish_name, SUM(销售份数) AS sales_volume, SUM(折后销售额) AS post_discount_sales, (SUM(折后销售额) / SUM(销售份数)) AS avg_price_per_unit FROM 档口菜品毛利分析 GROUP BY 菜品名称 ORDER BY sales_volume DESC LIMIT 8;",
      "column_name": [
        "dish_name",
        "sales_volume",
        "post_discount_sales",
        "avg_price_per_unit"
