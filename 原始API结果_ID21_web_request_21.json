    {
      "chart_uid": "051cd164-0bf1-11f0-b328-bc2411cbc733",
      "chart_name": "菜品盈利情况分析",
      "chart_type": "LineChart",
      "chart_desc": "分析菜品的理论成本额与实际销售额的关系，可以了解每种菜品的盈利情况。这有助于识别高利润和低利润菜品，为优化菜单和成本控制提供依据。",
      "chart_sql": "SELECT 菜品名称 AS dish_name, SUM(折后销售额) AS post_discount_sales, SUM(非税理论成本额) AS theoretical_cost, (SUM(折后销售额) - SUM(非税理论成本额)) AS profit_margin FROM 档口菜品毛利分析 GROUP BY 菜品名称 ORDER BY profit_margin DESC LIMIT 8;",
