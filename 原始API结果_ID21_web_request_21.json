      "chart_uid": "051c131e-0bf1-11f0-b328-bc2411cbc733",
      "chart_name": "菜品销售额贡献比例分析",
      "chart_type": "PieChart",
      "chart_desc": "为了评估各种菜品的销售量与销售额对整体营业额的贡献，我们需要从菜品销售数据中提取菜品名称、销售份数、折前销售额和折后销售额，并计算每种菜品对总销售额的贡献比例。通过这些维度，我们可以了解哪些菜品对营业额的贡献最大，为优化菜品结构和提升营业额提供依据。",
      "chart_sql": "SELECT 菜品名称 AS dish_name, SUM(折前销售额) AS pre_discount_sales, SUM(折后销售额) AS post_discount_sales, (SUM(折后销售额) * 100.0 / (SELECT SUM(折后销售额) FROM 档口菜品毛利分析)) AS contribution_percentage FROM 档口菜品毛利分析 GROUP BY 菜品名称 ORDER BY contribution_percentage DESC LIMIT 8;",
      "column_name": [
        "dish_name",
        "pre_discount_sales",
        "post_discount_sales",
        "contribution_percentage"
      ],
