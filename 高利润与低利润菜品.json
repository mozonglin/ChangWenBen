    {
      "chart_uid": "914e9364-096e-11f0-b328-bc2411cbc733",
      "chart_name": "菜品成本与理论毛利占比分析",
      "chart_type": "PieChart",
      "chart_desc": "分析不同菜品的非税理论成本额与理论毛利的关系，可以帮助我们了解哪些菜品的成本控制较好，哪些菜品的成本较高导致利润较低。通过对比成本和毛利，可以发现菜品的成本结构和盈利情况。使用PieChart展示数据占比，可以直观地看到不同菜品的成本和毛利占比。",
      "chart_sql": "SELECT 菜品名称 AS dish_name, SUM(非税理论成本额) AS cost_amount, SUM(折后理论毛利) AS post_discount_profit, (SUM(折后理论毛利) / SUM(非税理论成本额)) AS profit_ratio FROM 档口菜品毛利分析 GROUP BY 菜品名称 ORDER BY profit_ratio DESC LIMIT 10;",
