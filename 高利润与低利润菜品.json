    {
      "chart_uid": "914e5dcc-096e-11f0-b328-bc2411cbc733",
      "chart_name": "菜品折扣前后销售额与毛利变化分析",
      "chart_type": "LineChart",
      "chart_desc": "通过对比不同菜品的折前销售额和折后销售额，可以分析价格折扣对菜品利润的影响。高利润菜品可能在折扣后依然保持较高的销售额和毛利，而低利润菜品可能在折扣后销售额和毛利都显著下降。使用LineChart展示数据变化趋势，可以直观地看到不同菜品在折扣前后的销售额和毛利变化。",
      "chart_sql": "SELECT 菜品名称 AS dish_name, SUM(折前销售额) AS pre_discount_sales, SUM(折后销售额) AS post_discount_sales, (SUM(折后销售额) - SUM(折前销售额)) AS sales_difference FROM 档口菜品毛利分析 GROUP BY 菜品名称 ORDER BY post_discount_sales DESC LIMIT 10;",
