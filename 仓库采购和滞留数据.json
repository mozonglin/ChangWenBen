    {
      "chart_uid": "d1e50734-096c-11f0-b328-bc2411cbc733",
      "chart_name": "预测误差来源分析",
      "chart_type": "IndicatorValue",
      "chart_desc": "通过分析仓库采购数据，结合历史销售数据，可以预测未来的需求量，避免缺漏风险。选择显示指标值，可以直观展示预测误差来源，帮助采购部门细化调整建议。",
      "chart_sql": "SELECT AVG(`累计入库数量`) AS avg_purchase, AVG(`累计出库数量`) AS avg_sales, AVG(`累计入库数量` - `累计出库数量`) AS avg_error FROM `门店仓库品项收发存汇总表`;",
      "column_name": [
        "avg_purchase",
        "avg_sales",
        "avg_error"
