      "chart_uid": "6583d50e-0979-11f0-b328-bc2411cbc733",
      "chart_name": "促销活动期间菜品销量与库存变化分析",
      "chart_type": "BarChart",
      "chart_desc": "为了更深入地了解促销活动期间的关键指标波动，我们需要关注菜品的销售份数和销售额的变化趋势。通过对比促销活动前后的数据，可以识别出异常波动。同时，结合库存数据，分析净入库量和净出库量的变化，以评估库存管理的效率。",
      "chart_sql": "SELECT T1.菜品名称 AS dish_name, SUM(T1.销售份数) AS total_sales, SUM(T2.净入库数量) AS total_in, SUM(T2.净出库数量) AS total_out FROM 档口菜品毛利分析 AS T1 JOIN 门店仓库品项收发存汇总表 AS T2 ON T1.菜品名称 = T2.品项名称 GROUP BY T1.菜品名称",
      "column_name": [
        "dish_name",
        "total_sales",
        "total_in",
        "total_out"
      ],
